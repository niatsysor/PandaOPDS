# PandaOPDS 首页布局
# ====================
#
# [[section]]                    # 单一数组，书写顺序 = OPDS 输出顺序
#
# kind = "publication"           → groups[] 含 publications[]（内嵌预览）
# kind = "navigation"            → groups[] 含 navigation[]（纯导航壳）
# kind = "navigation"  root=true → 根 navigation[]
#
# type: "preset" → 内置浏览维度
#   query: latest / popular / watched / favorites
#         toplist:yesterday / toplist:month / toplist:year / toplist:alltime
# type: "search" → E-Hentai 自由搜索表达式

[[section]]
kind = "publication"
title = "昨日最佳"
type = "preset"
query = "toplist:yesterday"
count = 5

[[section]]
kind = "navigation"
title = "月度精选"
type = "preset"
query = "toplist:month"

[[section]]
kind = "navigation"
title = "年度佳作"
type = "preset"
query = "toplist:year"

[[section]]
kind = "publication"
title = "本周热门"
type = "preset"
query = "popular"
count = 10

[[section]]
kind = "navigation"
title = "最新上传"
type = "preset"
query = "latest"

[[section]]
kind = "publication"
title = "中文同人"
type = "search"
query = "language:chinese"
count = 15

[[section]]
kind = "navigation"
root = true
title = "历史总榜"
type = "preset"
query = "toplist:alltime"

[[section]]
kind = "navigation"
root = true
title = "我的收藏"
type = "preset"
query = "favorites"

[[section]]
kind = "navigation"
root = true
title = "日文原版"
type = "search"
query = "language:japanese"
