# PandaOPDS 首页布局
# ====================
#
# [[group]]        → OPDS 2.0 groups[]，含内嵌 publication 预览
# [[navigation]]   → OPDS 2.0 根级 navigation[]，纯链接无预览
#
# 复制此文件为 home.toml 并自定义。

[[group]]
title = "昨日最佳"
type = "preset"
query = "toplist:yesterday"
publications = 5

[[group]]
title = "月度精选"
type = "preset"
query = "toplist:month"
publications = 10

[[group]]
title = "年度佳作"
type = "preset"
query = "toplist:year"
publications = 10

[[group]]
title = "本周热门"
type = "preset"
query = "popular"
publications = 10

[[group]]
title = "最新上传"
type = "preset"
query = "latest"
publications = 20

[[group]]
title = "中文同人"
type = "search"
query = "language:chinese"
publications = 15

[[navigation]]
title = "历史总榜"
type = "preset"
query = "toplist:alltime"

[[navigation]]
title = "我的收藏"
