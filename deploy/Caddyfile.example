# Caddy reverse proxy example for PandaOPDS.
# Automatic TLS via Let's Encrypt. Requires PUBLIC_BASE_URL=https://opds.example.com
# in the PandaOPDS environment.

opds.example.com {
    reverse_proxy 127.0.0.1:8000 {
        # pass the original Host through
        header_up Host {host}
    }

    encode zstd gzip

    # Access control: the app itself ships optional Basic Auth
    # (AUTH_USERNAME + AUTH_PASSWORD env vars, /health and AUTH_EXEMPT_PATHS
    # stay public). An extra reverse-proxy layer is optional, e.g.:
    #
    #     basic_auth {
    #         reader $2a$14$...
    #     }
    #
    # The app's 401 carries WWW-Authenticate; Caddy basic_auth is independent.
}
